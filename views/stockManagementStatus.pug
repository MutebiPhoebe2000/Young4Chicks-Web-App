head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Stock Management-Status  
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css' rel='stylesheet' integrity='sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr' crossorigin='anonymous')
  link(rel='stylesheet' href='/css/style.css')
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css')
nav.navbar.navbar-expand-lg.navbar-dark.sticky-top
  .container
    a.navbar-brand.fw-bold(href='#') Young4ChickS
    button.navbar-toggler(type='button' data-bs-toggle='collapse' data-bs-target='#navbarNavDropdown')
      span.navbar-toggler-icon
    #navbarNavDropdown.collapse.navbar-collapse
      ul.navbar-nav.me-auto.mb-2.mb-lg-0
        li.nav-item
          a.nav-link(href='index.html') Home
        li.nav-item
          a.nav-link(href='managerDashboard.html') Dashboard
        button#logoutBtn.btn.btn-outline-danger(type='button' title='Logout')
          i.bi.bi-box-arrow-right
section#stock-management.py-5.bg-light
  .container-lg
    .text-center.mb-5
      h1.display-4.fw-bold Stock Management
      p.lead.text-muted Manage and monitor all your poultry stock entries in one place.
    .table-responsive
      table.table.table-bordered.table-hover.align-middle
        thead.text-center
          tr
            th Title
            th Stock ID
            th Breed Type
            th Quantity Available
            th Last Restocked
            th Supplier Name
            th Expiry Date
            th Status
            th Action
        tbody.text-center
          tr
            td Chick Batch A1
            td Y4C-001
            td Kuroiler
            td 150
            td 2025-07-01
            td FarmFresh Supplies
            td 2025-08-15
            td
              span.badge.bg-success Available
            td
              button.btn.btn-sm.btn-primary Edit
              button.btn.btn-sm.btn-danger Delete
          tr
            td Egg Tray B2
            td Y4C-002
            td Layers
            td 300
            td 2025-06-28
            td EggWorld Ltd
            td 2025-07-20
            td
              span.badge.bg-warning.text-dark Low Stock
            td
              button.btn.btn-sm.btn-primary Edit
              button.btn.btn-sm.btn-danger Delete
footer.whole-footer
  .container
    .row.text-center.text-md-start
      .container.mb-3.text-center
        h3 Quick Links
      ul.container.list-unstyled.text-center
        li
          a.text-white(href='index.html') Home
        li
          a.text-white(href='about.html') About
        li
          a.text-white(href='login.html') Login
    .container.mb-3.text-center
      h5 Join Us
    .d-flex.justify-content-center.justify-content-md-center
      a(href='#')
