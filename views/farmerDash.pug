head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Farmer Dashboard - Young For Chicks
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css' rel='stylesheet')
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css')
  link(rel='stylesheet' href='/css/farmer.css')

nav.navbar.navbar-expand-lg.navbar-dark.sticky-top
  .container
    a.navbar-brand.fw-bold(href='/') Young4ChickS
    button.navbar-toggler(type='button' data-bs-toggle='collapse' data-bs-target='#navbarNavDropdown')
      span.navbar-toggler-icon
    #navbarNavDropdown.collapse.navbar-collapse
      ul.navbar-nav.me-auto.mb-2.mb-lg-0
        li.nav-item
          a.nav-link(href='/') Home
        li.nav-item
          a.nav-link(href='/aboutPage') About
        li.nav-item
          a.nav-link(href='/contactPage') Contact Us
        li.nav-item
          a.nav-link(href='/chickRequest') Chicks
      a#logoutBtn.btn.btn-outline-light(type='button' title='Logout' href='/')
        i.bi.bi-box-arrow-right
        |  Logout

.dashboard-container
  aside.sidebar
    h4
      i.bi.bi-person-circle
      |  Farmer Panel
    ul
      li
        a.sidebar-link.active(href='#' data-section='overview')
          i.bi.bi-house-door
          |  Overview
      li
        a.sidebar-link(href='#' data-section='my-requests')
          i.bi.bi-clipboard-check
          |  My Requests
      li
        a.sidebar-link(href='#' data-section='new-request')
          i.bi.bi-plus-circle
          |  New Request
      li
        a.sidebar-link(href='#' data-section='my-payments')
          i.bi.bi-credit-card
          |  My Payments
      li
        a.sidebar-link(href='#' data-section='my-deliveries')
          i.bi.bi-truck
          |  My Deliveries
      li
        a.sidebar-link(href='#' data-section='profile')
          i.bi.bi-person-gear
          |  Profile

  main.main-content
    section#overview.dashboard-section.active
      h2.mb-4
        | Welcome, 
        span#farmerName #{user ? user.farmerFName : 'Farmer'}
        | !
      .stats-cards
        .stat-card.red
          h3 Total Requests
          #totalRequestsCount.number #{totalRequests || 0}
        .stat-card.orange
          h3 Pending Requests
          #pendingRequestsCount.number #{pendingRequests || 0}
        .stat-card.green
          h3 Completed Orders
          #completedOrdersCount.number #{completedOrders || 0}
        .stat-card.blue
          h3 Total Spent
          #totalSpentAmount.number #{totalSpent || 0}

    section#my-requests.dashboard-section
      h3.mb-3 My Requests
      
      // Search and Filter Section - Easy to understand!
      .row.mb-4
        .col-md-6
          .input-group
            input#requestSearch.form-control(type='text' placeholder='Search requests by ID, chick type, or status...')
            button.btn.btn-primary(type='button')
              i.bi.bi-search
        .col-md-6
          select#statusFilter.form-select
            option(value='') All Status
            option(value='Pending') Pending
            option(value='Approved') Approved
            option(value='Dispatched') Dispatched
            option(value='Completed') Completed
      
      .card
        .card-body
          .table-responsive
            table.table.table-striped
              thead
                tr
                  th Date
                  th Request ID
                  th Chick Type
                  th Chicks Quantity
                  th Chick Feeds
                  th Feeds Quantity
                  th Status
                  th Actions
              tbody#farmerRequestsTable
                if chickRequests && chickRequests.length > 0
                  each request in chickRequests
                    tr
                      td= new Date(request.createdAt).toLocaleDateString()
                      td= request._id.toString().slice(-6)
                      td= request.typeChicks
                      td= request.numChicks
                      td -
                      td -
                      td
                        span.badge(class=request.status === 'Pending' ? 'bg-warning' : (request.status === 'Approved' ? 'bg-success' : (request.status === 'Cancelled' ? 'bg-danger' : 'bg-info')))= request.status
                      td.action-buttons
                        button.btn.btn-sm.btn-info.me-1(onclick=`viewRequest('${request._id}')`) View
                        if request.status === 'Pending'
                          button.btn.btn-sm.btn-danger(onclick=`cancelRequest('${request._id}')`) Cancel
                else
                  tr
                    td(colspan="8") No requests found

    section#new-request.dashboard-section
      h3.mb-3 Submit New Request
      
      // Quick Request Button - Simple and clear!
      .row.mb-3
        .col-12
          button#quickRequestBtn.btn.btn-success(type='button')
            i.bi.bi-lightning.me-2
            | Quick Request (Most Popular)
      
      .card
        .card-body
          form#newRequestForm.farmerReg(action="/farmerDash/new-request" method="POST")
            .row
              .col-md-6.mb-3
                label.form-label(for='chickType') Chick Type
                select#chickType.form-select(name='typeChicks' required)
                  option(value='') Select Type
                  option(value='Broilers') Broilers
                  option(value='Layers') Layers
                #chickTypeErr.showerr
              .col-md-6.mb-3
                label.form-label(for='chickFeeds') Chick Feeds
                select#chickFeeds.form-select(name='chickFeeds')
                  option(value='') Select Feeds
                  option(value='Starter') Starter Feeds
                  option(value='Grower') Grower Feeds
                  option(value='Finisher') Finisher Feeds
                  option(value='Layer') Layer Feeds
                  option(value='Medicated') Medicated Feeds
                  option(value='Organic') Organic Feeds
                  option(value='Supplementary') Supplementary Feeds
                #chickFeedsErr.showerr
              .col-md-6.mb-3
                label.form-label(for='chicksQuantity') Chicks Quantity
                input#chicksQuantity.form-control(type='number' name='numChicks' min='100' max='500')
                #chicksQuantityErr.showerr
              .col-md-6.mb-3
                label.form-label(for='feedsQuantity') Feeds Quantity
                input#feedsQuantity.form-control(type='number' name='feedsQuantity' min='1' max='500')
                #feedsQuantityErr.showerr
            .mb-3
              label.form-label(for='farmerType') Farmer Type
              select#farmerType.form-select(name='farmerType')
                option(value='') Select Type
                option(value='Starter') Starter
                option(value='Returning') Returning
              #farmerTypeErr.showerr
            .mb-3
              label.form-label(for='deliveryDate') Preferred Delivery Date
              input#deliveryDate.form-control(type='date' name='deliveryDate')
              #deliveryDateErr.showerr
            .mb-3
              label.form-label(for='notes') Additional Notes
              textarea#notes.form-control(name='notes' rows='3')
              #notesErr.showerr
            button.btn.btn-success(type='submit')
              i.bi.bi-send
              |  Submit Request

    section#my-payments.dashboard-section
      h3.mb-3 My Payments
      
      // Payment Summary Cards - Easy to understand!
      .row.mb-4
        .col-md-4
          .card.bg-success.text-white
            .card-body.text-center
              h5.card-title Total Paid
              h3.card-text #{totalPaid || 0} shs
        .col-md-4
          .card.bg-warning.text-dark
            .card-body.text-center
              h5.card-title Pending Payment
              h3.card-text #{pendingPayment || 0} shs
        .col-md-4
          .card.bg-info.text-white
            .card-body.text-center
              h5.card-title Next Due
              h3.card-text #{nextDue || 0} shs
      
      .card
        .card-body
          .table-responsive
            table.table.table-bordered
              thead
                tr
                  th Date
                  th Payment ID
                  th Request ID
                  th Amount
                  th Status
              tbody#farmerPaymentsTable
                tr
                  td(colspan="5") No payments found

    section#my-deliveries.dashboard-section
      h3.mb-3 My Deliveries
      
      // Delivery Status Overview - Simple and clear!
      .row.mb-4
        .col-md-3
          .text-center
            i.bi.bi-truck.text-primary.fs-1
            h5 Pending
            h3.text-primary #{pendingDeliveries || 0}
        .col-md-3
          .text-center
            i.bi.bi-box-seam.text-warning.fs-1
            h5 In Transit
            h3.text-warning #{inTransit || 0}
        .col-md-3
          .text-center
            i.bi.bi-check-circle.text-success.fs-1
            h5 Delivered
            h3.text-success #{delivered || 0}
        .col-md-3
          .text-center
            i.bi.bi-calendar-event.text-info.fs-1
            h5 Scheduled
            h3.text-info #{scheduled || 0}
      
      .card
        .card-body
          .table-responsive
            table.table.table-hover
              thead
                tr
                  th Delivery Date
                  th Chicken Products
                  th Chick Quantity
                  th Feeds Products
                  th Feeds Quantity
                  th Status
                  th Tracking
              tbody#farmerDeliveriesTable
                tr
                  td(colspan="7") No deliveries found

    section#profile.dashboard-section
      h3.mb-3 My Profile
      
      // Profile Summary Card - Easy to understand!
      .row.mb-4
        .col-md-4
          .card.text-center
            .card-body
              i.bi.bi-person-circle.text-primary.fs-1
              h5.card-title.mt-2 #{user ? user.farmerFName : 'Farmer Name'}
              p.card-text.text-muted #{user ? user.farmerFEmail : 'email@example.com'}
              button#editProfileBtn.btn.btn-outline-primary.btn-sm
                i.bi.bi-pencil.me-1
                | Edit Profile
      
      .row
        .col-md-8
          .card
            .card-body
              form#profileForm.profileForm(action='/farmerDash/update-profile' method='POST')
                .row
                  .col-md-6.mb-3
                    label.form-label(for='fullName') Full Name
                    input#fullName.form-control(type='text' name='farmerFName' value=user ? user.farmerFName : '')
                    #fullNameErr.showerr
                  .col-md-6.mb-3
                    label.form-label(for='email') Email
                    input#email.form-control(type='email' name='farmerFEmail' value=user ? user.farmerFEmail : '')
                    #emailErr.showerr
                .row
                  .col-md-6.mb-3
                    label.form-label(for='phone') Phone Number
                    input#phone.form-control(type='tel' name='farmerFNumber' value=user ? user.farmerFNumber : '')
                    #phoneErr.showerr
                  .col-md-6.mb-3
                    label.form-label(for='location') Farm Location
                    input#location.form-control(type='text' name='farmerFAddress' value=user ? user.farmerFAddress : '')
                    #locationErr.showerr
                button.btn.btn-primary(type='submit')
                  i.bi.bi-save
                  |  Update Profile

footer.whole-footer
  .container
    .row.text-center.text-md-start
      .container.mb-3.text-center
        h3 Quick Links
      ul.container.list-unstyled.text-center
        li
          a.text-white(href='/') Home
        li
          a.text-white(href='/aboutPage') About
        li
          a.text-white(href='/chickRequest') Chicks
        li
          a.text-white(href='/login') Login
    .container.mb-3.text-center
      h5 Join Us
    .d-flex.justify-content-center
      a(href='#')
        img(src='data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAAm0lEQVR4AWP4//8/RRhMyLfs3sNQvOk/KRikB24ATNB2yhEQJtoQuAEwzVAAYtPVAMJe4Cjf8l+0bsd/RkIGQAGc/ej9t/+TDt/7/+TDt/7/+vPXzD/6Yfv/+2nHSXWAAT49P33/z9//4HZl559JM2Aqm3XwXyXGcfA/H///pFmgFj9DjCfp3IrTIgkA5ADbbAbQA6mKDPp9x7YBTOAIgwAVba5DGceMlQAAAAASUVORK5CYII=' alt='LinkedIn')
    hr.border-light
    p.text-center.mb-0 &copy; 2025 Young4Chicks. All rights reserved.

// Quick Request Modal - Simple and easy to understand!
#quickRequestModal.modal.fade(tabindex='-1')
  .modal-dialog
    .modal-content
      .modal-header
        h5.modal-title Quick Request - Most Popular
        button.btn-close(type='button' data-bs-dismiss='modal')
      .modal-body
        form#quickRequestForm(action="/farmerDash/quick-request" method="POST")
          .mb-3
            label.form-label(for='quickChickType') Chick Type
            select#quickChickType.form-select(name="quickChickType" required)
              option(value='') Select Type
              option(value='Broilers') Broilers (Most Popular)
              option(value='Layers') Layers
          .mb-3
            label.form-label(for='quickQuantity') Quantity
            input#quickQuantity.form-control(type='number' name="quickQuantity" min='100' max='500' value='100' required)
            small.text-muted Minimum 100 chicks
          .mb-3
            label.form-label(for='quickDeliveryDate') Delivery Date
            input#quickDeliveryDate.form-control(type='date' name="quickDeliveryDate" required)
      .modal-footer
        button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cancel
        button#saveQuickRequestBtn.btn.btn-success(type='submit' form="quickRequestForm") Submit Quick Request

script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js')
script.
  document.addEventListener('DOMContentLoaded', function () {
    // Sidebar navigation - Simple and clear!
    document.querySelectorAll('.sidebar-link').forEach(link => {
      link.addEventListener('click', function (e) {
        e.preventDefault();
        const section = this.getAttribute('data-section');
        
        // Hide all sections
        document.querySelectorAll('.dashboard-section').forEach(s => {
          s.classList.remove('active');
        });
        
        // Remove active from all links
        document.querySelectorAll('.sidebar-link').forEach(l => {
          l.classList.remove('active');
        });
        
        // Show selected section and activate link
        document.getElementById(section).classList.add('active');
        this.classList.add('active');
      });
    });

    // Logout functionality - Easy to understand!
    document.getElementById('logoutBtn').addEventListener('click', function() {
      if(confirm('Are you sure you want to logout?')) {
        window.location.href = '/logout';
      }
    });

    // NEW: Quick Request Modal Functionality - Simple and clear!
    const quickRequestBtn = document.getElementById('quickRequestBtn');
    const quickRequestModal = new bootstrap.Modal(document.getElementById('quickRequestModal'));
    const saveQuickRequestBtn = document.getElementById('saveQuickRequestBtn');

    // Open modal when "Quick Request" button is clicked
    quickRequestBtn.addEventListener('click', function() {
      // Set default delivery date to next week
      const nextWeek = new Date();
      nextWeek.setDate(nextWeek.getDate() + 7);
      document.getElementById('quickDeliveryDate').value = nextWeek.toISOString().split('T')[0];
      
      quickRequestModal.show();
    });

    // Save quick request when form is submitted
    saveQuickRequestBtn.addEventListener('click', function() {
      const chickType = document.getElementById('quickChickType').value.trim();
      const quantity = document.getElementById('quickQuantity').value.trim();
      const deliveryDate = document.getElementById('quickDeliveryDate').value;

      // Simple validation - Easy to understand!
      if (!chickType || !quantity || !deliveryDate) {
        alert('Please fill in all fields!');
        return;
      }

      if (quantity < 100 || quantity > 500) {
        alert('Quantity must be between 100 and 500 chicks!');
        return;
      }

      // In real app, this would save to database
      alert(`Quick request submitted!\nChick Type: ${chickType}\nQuantity: ${quantity}\nDelivery: ${deliveryDate}`);
      
      // Close modal and reset form
      quickRequestModal.hide();
      document.getElementById('quickRequestForm').reset();
    });

    // Function to view request details
    window.viewRequest = function(id) {
      fetch(`/farmerDash/request/${id}`)
        .then(res => res.json())
        .then(data => {
          if (data.error) {
            alert(data.error);
          } else {
            alert(`Request Details:\nID: ${data._id.slice(-6)}\nType: ${data.typeChicks}\nQuantity: ${data.numChicks}\nStatus: ${data.status}\nNotes: ${data.notes || 'None'}`);
          }
        })
        .catch(err => alert('Error fetching details'));
    };

    // Function to cancel request
    window.cancelRequest = function(id) {
      if (confirm('Are you sure you want to cancel this request?')) {
        fetch(`/farmerDash/cancel-request/${id}`, { method: 'POST' })
          .then(res => res.json())
          .then(data => {
            if (data.success) {
              alert('Request cancelled successfully');
              window.location.reload();
            } else {
              alert(data.error || 'Failed to cancel request');
            }
          })
          .catch(err => alert('Error cancelling request'));
      }
    };
    const requestSearch = document.getElementById('requestSearch');
    const statusFilter = document.getElementById('statusFilter');
    const requestRows = document.querySelectorAll('#farmerRequestsTable tr');

    // Search functionality
    requestSearch.addEventListener('input', function() {
      const searchTerm = this.value.toLowerCase();
      filterRequests(searchTerm, statusFilter.value);
    });

    // Filter functionality
    statusFilter.addEventListener('change', function() {
      const searchTerm = requestSearch.value.toLowerCase();
      filterRequests(searchTerm, this.value);
    });

    // Function to filter requests - Simple and clear!
    function filterRequests(searchTerm, statusFilter) {
      requestRows.forEach(row => {
        if (row.cells.length < 8) return; // Skip header row
        
        const requestId = row.cells[1].textContent.toLowerCase();
        const chickType = row.cells[2].textContent.toLowerCase();
        const status = row.cells[6].textContent;
        
        const matchesSearch = requestId.includes(searchTerm) || 
                             chickType.includes(searchTerm);
        
        const matchesStatus = !statusFilter || status.includes(statusFilter);
        
        // Show/hide row based on filters
        if (matchesSearch && matchesStatus) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    }

    // NEW: Profile Edit Toggle - Simple and clear!
    const editProfileBtn = document.getElementById('editProfileBtn');
    const profileForm = document.getElementById('profileForm');
    const profileInputs = profileForm.querySelectorAll('input');

    // Initially disable profile inputs
    profileInputs.forEach(input => input.disabled = true);

    // Toggle edit mode when button is clicked
    editProfileBtn.addEventListener('click', function() {
      const isEditing = !profileInputs[0].disabled;
      
      if (isEditing) {
        // Save mode
        profileInputs.forEach(input => input.disabled = true);
        this.innerHTML = '<i class="bi bi-pencil me-1"></i>Edit Profile';
        this.className = 'btn btn-outline-primary btn-sm';
      } else {
        // Edit mode
        profileInputs.forEach(input => input.disabled = false);
        this.innerHTML = '<i class="bi bi-check me-1"></i>Save Changes';
        this.className = 'btn btn-success btn-sm';
      }
    });
  });

  // Simple form validation for new request - Easy to understand!
  function validateRequestForm(event) {
    let errFlag = false;
    
    let chickType = document.getElementById('chickType').value.trim();
    let chicksQuantity = document.getElementById('chicksQuantity').value.trim();
    let farmerType = document.getElementById('farmerType').value.trim();

    // Clear previous errors
    document.querySelectorAll('.showerr').forEach(err => err.innerText = '');

    if (chickType === "") {
      document.getElementById('chickTypeErr').innerText = "Please select chick type";
      errFlag = true;
    }

    if (chicksQuantity === "" || isNaN(chicksQuantity) || Number(chicksQuantity) < 100) {
      document.getElementById('chicksQuantityErr').innerText = "Enter valid number of chicks (minimum 100)";
      errFlag = true;
    }

    if (farmerType === "") {
      document.getElementById('farmerTypeErr').innerText = "Please select farmer type";
      errFlag = true;
    }

    if (errFlag) {
      event.preventDefault();
      return false;
    }
    return true;
  }

  // Add validation to the form
  const newRequestForm = document.getElementById('newRequestForm');
  if (newRequestForm) {
    newRequestForm.addEventListener('submit', validateRequestForm);
  }

  // Simple profile form validation - Easy to understand!
  function validateProfileForm(event) {
    let errFlag = false;
    
    let fullName = document.getElementById("fullName").value.trim();
    let email = document.getElementById("email").value.trim();
    let phone = document.getElementById("phone").value.trim();
    let location = document.getElementById("location").value.trim();

    // Clear previous errors
    document.querySelectorAll('.showerr').forEach(err => err.innerHTML = '');

    if (fullName === "") {
      document.getElementById("fullNameErr").innerHTML = "Full name is required";
      errFlag = true;
    }

    if (email === "") {
      document.getElementById("emailErr").innerHTML = "Email is required";
      errFlag = true;
    }

    if (phone === "") {
      document.getElementById("phoneErr").innerHTML = "Phone number is required";
      errFlag = true;
    }

    if (location === "") {
      document.getElementById("locationErr").innerHTML = "Farm location is required";
      errFlag = true;
    }

    if (errFlag) {
      event.preventDefault();
      return false;
    }
    return true;
  }

  // Add validation to profile form
  const profileForm = document.getElementById('profileForm');
  if (profileForm) {
    profileForm.addEventListener('submit', validateProfileForm);
  }
