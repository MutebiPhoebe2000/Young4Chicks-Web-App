head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Young4Chicks Stock-List
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css' rel='stylesheet' integrity='sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr' crossorigin='anonymous')
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css')
  link(rel='stylesheet' href='/css/style.css')
nav.navbar.navbar-expand-lg.navbar-dark.sticky-top
  .container
    a.navbar-brand.fw-bold(href='#') Young4ChickS
    button.navbar-toggler(type='button' data-bs-toggle='collapse' data-bs-target='#navbarNavDropdown')
      span.navbar-toggler-icon
    #navbarNavDropdown.collapse.navbar-collapse
      ul.navbar-nav.me-auto.mb-2.mb-lg-0
        li.nav-item
          a.nav-link.active(href='index.html') Home
        li.nav-item
          a.nav-link(href='about.html') About
        li.nav-item
          a.nav-link(href='chick-request-form.html') Request Chicks 
  .card.p-4.shadow-lg.mx-auto.mt-5(style='width: 100%; max-width: 500px;')
    .mb-3.text-center
      a(href='index.html')
        img(src='/images/logo/horizontal logo.png' alt='Young4ChickS Logo' height='50')
    h4.mb-3.text-center Add Chick Stock 
    form#chickRequestForm(action='/addStock' method='post' novalidate='')
      .mb-3
        label.form-label(for='name') Category:
        select#chickType.form-select(name='category' type='text')
          option(value='') Select Category:
          option(value='local') Local 
          option(value='exotic') Exotic 
        .invalid-feedback Please select a category.
      .mb-3
        label.form-label(for='quantity') Number of Chicks
        input#quantity.form-control(name='quantity' type='number' min='1')
        .invalid-feedback Please enter a valid number of chicks.
      .mb-3
        label.form-label(for='chickType') Chick type
        select#chickType.form-select(name='chickType' type='text')
          option(value='') Select Type:
          option(value='Broiler') Broiler
          option(value='Layer') Layer
          option(value='Kuroiler') Kuroiler
        .invalid-feedback Please select a chick type.
      .mb-3
        label.form-label(for='stockDate') stocked on
        input#stockDate.form-control(type='date' name='stockDate')
        .invalid-feedback Please choose a valid delivery date.
      .mb-3 
         label.form-label(for='age') Age in days
         input#age.form-control(type='number' name='age' min='100' max='500')
         .invalid-feedback Age should be between 20 and 30 years.  
      button.btn.btn-primary.w-100(type='submit') Submit Request