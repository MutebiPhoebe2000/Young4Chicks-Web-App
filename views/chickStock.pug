head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Chick Stock-Form
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css' rel='stylesheet' integrity='sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr' crossorigin='anonymous')
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css')
  link(rel='stylesheet' href='/css/forms.css')
nav.navbar.navbar-expand-lg.navbar-dark.sticky-top
  .container
    a.navbar-brand.fw-bold(href='#') Add Stock - Young4ChickS
    button.navbar-toggler(type='button' data-bs-toggle='collapse' data-bs-target='#navbarNavDropdown')
      span.navbar-toggler-icon
    #navbarNavDropdown.collapse.navbar-collapse
      ul.navbar-nav.me-auto.mb-2.mb-lg-0
        li.nav-item
          a.nav-link.active(href='/') Home
        li.nav-item
          a.nav-link(href='/aboutPage') About Us
        li.nav-item
          a.nav-link(href='/chickRequest') Request Chicks
        li.nav-item
          a.nav-link(href='/contactPage') Contact Us
.card.p-4.shadow-lg.mx-auto.mt-5(style='width: 100%; max-width: 500px; ')
  .mb-3.text-center
    a(href='/')
      img(src='/images/chicks-drinking.jpg' alt='Young4ChickS Logo' height='200' width='200')
  h4.mb-3.text-center Add Chick Stock
  form#chickRequestForm(action='/addStock' method='post' onsubmit='return validateForm()')
    .mb-3
      label.form-label(for='category') Category:
      select#category.form-select(name='category' type='text')
        option(value='') Select Category:
        option(value='local') Local
        option(value='exotic') Exotic
      #categoryErr.showerr
    .mb-3
      label.form-label(for='quantity') Number of Chicks
      input#quantity.form-control(name='quantity' type='number' min='1')
      #quantityErr.showerr
    .mb-3
      label.form-label(for='chickType') Chick type
      select#chickType.form-select(name='chickType' type='text')
        option(value='') Select Type:
        option(value='Broiler') Broiler
        option(value='Layer') Layer
      #chickTypeErr.showerr
    .mb-3
      label.form-label(for='stockDate') stocked on
      input#stockDate.form-control(type='date' name='stockDate')
      #stockDateErr.showerr
    .mb-3
      label.form-label(for='age') Age in days
      input#age.form-control(type='number' name='age' min='1')
      #ageErr.showerr
    button.btn.btn-primary.w-100(type='submit') Submit Request
footer.whole-footer
  .container
    .row.text-center.text-md-start
      .container.mb-3.text-center
        h3 Quick Links
      ul.container.list-unstyled.text-center
        li
          a.text-white(href='/') Home
        li
          a.text-white(href='/aboutPage') About
        li
          a.text-white(href='/chickRequest') Chicks
        li
          a.text-white(href='/login') Login
        li
          a.text-white(href='/addFarmer') Register
    .container.mb-3.text-center
      h5 Join Us
    .d-flex.justify-content-center.justify-content-md-center
      a(href='#')
        img(src='data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAAm0lEQVR4AWP4//8/RRhMyLfs3sNQvOk/KRikB24ATNB2yhEQJtoQuAEwzVAAYtPVAMJe4Cjf8l+0bsd/RkIGQAGc/ej9t/+TDt/7/+vPXzD/6Yfv/+2nHSXWAAT49P33/z9//4HZl559JM2Aqm3XwXyXGcfA/H///pFmgFj9DjCfp3IrTIgkA5ADbbAbQA6mKDPp9x7YBTOAIgwAVba5DGceMlQAAAAASUVORK5CYII=' alt='LinkedIn')
  hr.border-light
  p.text-center.mb-0 &copy; 2025 Young4Chicks. All rights reserved.
script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js' integrity='sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q' crossorigin='anonymous')
script(src='/js/formHandling.js')
script.
  const chickRequestForm = document.getElementById('chickRequestForm');
  function validateForm() {
  let category = document.getElementById('category').value.trim();
  let quantity = document.getElementById('quantity').value.trim();
  let chickType = document.getElementById('chickType').value.trim();
  let stockDate = document.getElementById('stockDate').value.trim();
  let age = document.getElementById('age').value.trim();
  let categoryErr = document.getElementById('categoryErr');
  let quantityErr = document.getElementById('quantityErr');
  let chickTypeErr = document.getElementById('chickTypeErr');
  let stockDateErr = document.getElementById('stockDateErr');
  let ageErr = document.getElementById('ageErr');
  let errFlag = false;
  if (category === '') {
  categoryErr.innerHTML = 'Please select a category!';
  errFlag = true;
  } else {
  categoryErr.innerHTML = '';
  }
  if (quantity === '') {
  quantityErr.innerHTML = 'Please enter number of chicks!';
  errFlag = true;
  } else {
  quantityErr.innerHTML = '';
  }
  if (chickType === '') {
  chickTypeErr.innerHTML = 'Please select chick type!';
  errFlag = true;
  } else {
  chickTypeErr.innerHTML = '';
  }
  if (stockDate === '') {
  stockDateErr.innerHTML = 'Please select stock date!';
  errFlag = true;
  } else {
  stockDateErr.innerHTML = '';
  }
  if (age === '') {
  ageErr.innerHTML = 'Please enter age in days!';
  errFlag = true;
  } else {
  ageErr.innerHTML = '';
  }
  if (errFlag) {
    return false;
  }
  return true;
  }
