doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Sales Agent Registration-Form
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css' rel='stylesheet' integrity='sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr' crossorigin='anonymous')
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css')
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css')
  link(rel='stylesheet' href='/public/css/forms.css')
// new navbar
nav.navbar.navbar-expand-lg.navbar-dark.sticky-top
  .container
    a.navbar-brand.fw-bold(href='#') Young4ChickS
    button.navbar-toggler(type='button' data-bs-toggle='collapse' data-bs-target='#navbarNavDropdown')
      span.navbar-toggler-icon
    #navbarNavDropdown.collapse.navbar-collapse
      ul.navbar-nav.me-auto.mb-2.mb-lg-0
        li.nav-item
          a.nav-link.active(href='index.html') Home
        li.nav-item
          a.nav-link(href='about.html') About Us
        li.nav-item
          a.nav-link(href='chick-request-form.html') Chicks
        li.nav-item
          a.nav-link(href='login.html') Login
      .d-flex
        a.btn.btn-outline-light.me-2(href='#') Login
// end of new navbar
.container.my-5
  .card.shadow-lg.p-4.mx-auto(style='max-width: 600px;')
    h4.text-center.mb-4 Sales Agent Registration
    form#salesAgentForm(novalidate='')
      // Full Name
      .mb-3
        label.form-label(for='agentName') Full Name
        input#agentName.form-control(type='text' name='fullName')
        .invalid-feedback Please enter full name.
      // Employee ID
      .mb-3
        label.form-label(for='staffID') Employee ID / Staff Code
        input#staffID.form-control(type='text' name='employeeId')
        .invalid-feedback Please enter staff ID.
      // Contact
      .mb-3
        label.form-label(for='contactInfo') Contact (Phone or Email)
        input#contactInfo.form-control(type='text' name='email')
        .invalid-feedback Please provide contact details.
      // Office Location
      .mb-3
        label.form-label(for='location') Office Location
        input#location.form-control(type='text' placeholder='e.g., Ntinda Office' name='location')
        .invalid-feedback Please enter assigned office location.
      // Password
      .mb-3
        label.form-label(for='agentPassword') Password
        input#agentPassword.form-control(type='password' name='password')
        .invalid-feedback Please enter a password.
      // Confirm Password
      .mb-3
        label.form-label(for='confirmPassword') Confirm Password
        input#confirmPassword.form-control(type='password' name='confirmPassword')
        .invalid-feedback Please confirm the password.
      button.btn.btn-primary.w-100(type='submit') Register Agent
footer.whole-footer
  .container
    .row.text-center.text-md-start
      .container.mb-3.text-center
        h3 Quick Links
      ul.container.list-unstyled.text-center
        li
          a.text-white(href='home.html') Home
        li
          a.text-white(href='about.html') About
        li
          a.text-white(href='chicks.html') Chicks
        li
          a.text-white(href='login.html') Login
    // social media
    .container.mb-3.text-center
      h5 Join Us
    .d-flex.justify-content-center.justify-content-md-center
      a(href='#')
        img(src='data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAAm0lEQVR4AWP4//8/RRhMyLfs3sNQvOk/KRikB24ATNB2yhEQJtoQuAEwzVAAYtPVAMJe4Cjf8l+0bsd/RkIGQAGc/ej9t/+TDt/7/+vPXzD/6Yfv/+2nHSXWAAT49P33/z9//4HZl559JM2Aqm3XwXyXGcfA/H///pFmgFj9DjCfp3IrTIgkA5ADbbAbQA6mKDPp9x7YBTOAIgwAVba5DGceMlQAAAAASUVORK5CYII=' alt='LinkedIn')
  hr.border-light
  p.text-center.mb-0 &copy; 2025 Young4Chicks. All rights reserved.
