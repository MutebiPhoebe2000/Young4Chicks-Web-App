script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js')
script.
  // Simple sidebar navigation
  document.addEventListener('DOMContentLoaded', () => {
  // Listen for clicks on sidebar links
  document.querySelectorAll('.nav-link').forEach(link => {
  link.addEventListener('click', (e) => {
  e.preventDefault();
  // Get which section to show
  const section = link.getAttribute('data-section');
  // Hide all sections
  document.querySelectorAll('.section').forEach(s => {
  s.classList.remove('active');
  });
  // Remove active from all nav links
  document.querySelectorAll('.nav-link').forEach(l => {
  l.classList.remove('active');
  });
  // Show the clicked section
  document.getElementById(section).classList.add('active');
  // Make the clicked link active
  link.classList.add('active');
  });
  });
  });
  // Show/hide custom date range in report form based on reportPeriod select
  const reportPeriod = document.getElementById('reportPeriod');
  const customDateRange = document.getElementById('customDateRange');
  if(reportPeriod){
  reportPeriod.addEventListener('change', () => {
  if(reportPeriod.value === 'custom') {
  customDateRange.style.display = 'block';
  } else {
  customDateRange.style.display = 'none';
  // Clear custom dates errors and values when hidden
  document.getElementById('startDateError').textContent = '';
  document.getElementById('endDateError').textContent = '';
  }
  });
  }
  // Validation functions for each form, similar style to your login form:
  function validateProductForm() {
  clearProductErrors();
  let valid = true;
  const name = document.getElementById('productName').value.trim();
  if(name === '') {
  document.getElementById('productNameError').textContent = 'Product Name is required';
  valid = false;
  }
  const category = document.getElementById('productCategory').value;
  if(category === '') {
  document.getElementById('productCategoryError').textContent = 'Please select a category';
  valid = false;
  }
  const price = document.getElementById('productPrice').value.trim();
  if(price === '' || isNaN(price) || Number(price) <= 0) {
  document.getElementById('productPriceError').textContent = 'Enter a valid price greater than zero';
  valid = false;
  }
  const stock = document.getElementById('productStock').value.trim();
  if(stock === '' || isNaN(stock) || Number(stock) < 0) {
  document.getElementById('productStockError').textContent = 'Enter a valid stock number (0 or more)';
  valid = false;
  }
  const description = document.getElementById('productDescription').value.trim();
  if(description === '') {
  document.getElementById('productDescriptionError').textContent = 'Description is required';
  valid = false;
  }
  return valid;
  }
  function clearProductErrors() {
  document.getElementById('productNameError').textContent = '';
  document.getElementById('productCategoryError').textContent = '';
  document.getElementById('productPriceError').textContent = '';
  document.getElementById('productStockError').textContent = '';
  document.getElementById('productDescriptionError').textContent = '';
  }
  function validateReportForm() {
  clearReportErrors();
  let valid = true;
  const type = document.getElementById('reportType').value;
  if(type === '') {
  document.getElementById('reportTypeError').textContent = 'Please select a report type';
  valid = false;
  }
  const period = document.getElementById('reportPeriod').value;
  if(period === '') {
  document.getElementById('reportPeriodError').textContent = 'Please select a time period';
  valid = false;
  }
  if(period === 'custom') {
  const startDate = document.getElementById('startDate').value;
  const endDate = document.getElementById('endDate').value;
  if(startDate === '') {
  document.getElementById('startDateError').textContent = 'Start date is required';
  valid = false;
  }
  if(endDate === '') {
  document.getElementById('endDateError').textContent = 'End date is required';
  valid = false;
  }
  if(startDate !== '' && endDate !== '' && new Date(startDate) > new Date(endDate)) {
  document.getElementById('startDateError').textContent = 'Start date cannot be after end date';
  valid = false;
  }
  }
  return valid;
  }
  function clearReportErrors() {
  document.getElementById('reportTypeError').textContent = '';
  document.getElementById('reportPeriodError').textContent = '';
  document.getElementById('startDateError').textContent = '';
  document.getElementById('endDateError').textContent = '';
  }
  function validateNotificationForm() {
  clearNotificationErrors();
  let valid = true;
  const type = document.getElementById('notificationType').value;
  if(type === '') {
  document.getElementById('notificationTypeError').textContent = 'Please select notification type';
  valid = false;
  }
  const target = document.getElementById('notificationTarget').value;
  if(target === '') {
  document.getElementById('notificationTargetError').textContent = 'Please select recipients';
  valid = false;
  }
  const title = document.getElementById('notificationTitle').value.trim();
  if(title === '') {
  document.getElementById('notificationTitleError').textContent = 'Title is required';
  valid = false;
  }
  const message = document.getElementById('notificationMessage').value.trim();
  if(message === '') {
  document.getElementById('notificationMessageError').textContent = 'Message is required';
  valid = false;
  }
  return valid;
  }
  function clearNotificationErrors() {
  document.getElementById('notificationTypeError').textContent = '';
  document.getElementById('notificationTargetError').textContent = '';
  document.getElementById('notificationTitleError').textContent = '';
  document.getElementById('notificationMessageError').textContent = '';
  }
  function validateSettingsForm() {
  clearSettingsErrors();
  let valid = true;
  const siteName = document.getElementById('siteName').value.trim();
  if(siteName === '') {
  document.getElementById('siteNameError').textContent = 'Site name is required';
  valid = false;
  }
  const email = document.getElementById('contactEmail').value.trim();
  if(email === '') {
  document.getElementById('contactEmailError').textContent = 'Email is required';
  valid = false;
  } else if (!validateEmail(email)) {
  document.getElementById('contactEmailError').textContent = 'Invalid email format';
  valid = false;
  }
  const phone = document.getElementById('contactPhone').value.trim();
  if(phone === '') {
  document.getElementById('contactPhoneError').textContent = 'Phone number is required';
  valid = false;
  } else if (!validatePhone(phone)) {
  document.getElementById('contactPhoneError').textContent = 'Invalid phone number';
  valid = false;
  }
  const currency = document.getElementById('defaultCurrency').value;
  if(currency === '') {
  document.getElementById('defaultCurrencyError').textContent = 'Please select default currency';
  valid = false;
  }
  return valid;
  }
  function clearSettingsErrors() {
  document.getElementById('siteNameError').textContent = '';
  document.getElementById('contactEmailError').textContent = '';
  document.getElementById('contactPhoneError').textContent = '';
  document.getElementById('defaultCurrencyError').textContent = '';
  }
  function validatePasswordForm() {
  clearPasswordErrors();
  let valid = true;
  const currentPass = document.getElementById('currentPassword').value.trim();
  if(currentPass === '') {
  document.getElementById('currentPasswordError').textContent = 'Current password is required';
  valid = false;
  }
  const newPass = document.getElementById('newPassword').value.trim();
  if(newPass === '') {
  document.getElementById('newPasswordError').textContent = 'New password is required';
  valid = false;
  } else if (newPass.length < 6) {
  document.getElementById('newPasswordError').textContent = 'Password must be at least 6 characters';
  valid = false;
  }
  const confirmPass = document.getElementById('confirmNewPassword').value.trim();
  if(confirmPass === '') {
  document.getElementById('confirmNewPasswordError').textContent = 'Please confirm new password';
  valid = false;
  } else if (confirmPass !== newPass) {
  document.getElementById('confirmNewPasswordError').textContent = 'Passwords do not match';
  valid = false;
  }
  return valid;
  }
  function clearPasswordErrors() {
  document.getElementById('currentPasswordError').textContent = '';
  document.getElementById('newPasswordError').textContent = '';
  document.getElementById('confirmNewPasswordError').textContent = '';
  }
  // Helper email validation
  function validateEmail(email) {
  // Simple regex for email validation
  const re = /^[^\\s@]+@[^\s@]+\.[^\s@]+$/;
  return re.test(email);
  }
  // Helper phone validation (basic, digits, +, spaces)
  function validatePhone(phone) {
  const re = /^[\\d+\s\-()]{7,}$/;
  return re.test(phone);
  }
