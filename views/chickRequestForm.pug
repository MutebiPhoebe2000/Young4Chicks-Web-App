script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js' integrity='sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q' crossorigin='anonymous')
script.
  document.addEventListener("DOMContentLoaded", function () {
  const form = document.getElementById("chickRequestForm");
  form.addEventListener("submit", function (e) {
  e.preventDefault(); 
  let valid = true;
  const name = form.farmerName;
  const nin = form.farmerNIN;
  const numChicks = form.numChicks;
  const type = form.typeChicks;
  if (!name.value.trim()) {
  name.classList.add("is-invalid");
  name.classList.remove("is-valid");
  valid = false;
  } else {
  name.classList.remove("is-invalid");
  name.classList.add("is-valid");
  }
  if (!nin.value.trim()) {
  nin.classList.add("is-invalid");
  nin.classList.remove("is-valid");
  valid = false;
  } else {
  nin.classList.remove("is-invalid");
  nin.classList.add("is-valid");
  }
  const chicksValue = parseInt(numChicks.value, 10);
  if (
  isNaN(chicksValue) ||
  chicksValue < 100 ||
  chicksValue > 500
  ) {
  numChicks.classList.add("is-invalid");
  numChicks.classList.remove("is-valid");
  valid = false;
  } else {
  numChicks.classList.remove("is-invalid");
  numChicks.classList.add("is-valid");
  }
  if (!type.value) {
  type.classList.add("is-invalid");
  type.classList.remove("is-valid");
  valid = false;
  } else {
  type.classList.remove("is-invalid");
  type.classList.add("is-valid");
  }
  if (valid) {
  alert("Chick request submitted successfully!");
  }
  });
  });
