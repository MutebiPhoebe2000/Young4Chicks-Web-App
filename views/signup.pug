head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Signup - Young4Chicks
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css' rel='stylesheet')
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css')
  link(rel='stylesheet' href='/css/forms.css')
nav.navbar.navbar-expand-lg.navbar-dark.sticky-top
  .container
    a.navbar-brand.fw-bold(href='/signup') Young4ChickS
    button.navbar-toggler(type='button' data-bs-toggle='collapse' data-bs-target='#navbarNavDropdown')
      span.navbar-toggler-icon
    #navbarNavDropdown.collapse.navbar-collapse
      ul.navbar-nav.me-auto.mb-2.mb-lg-0
        li.nav-item
          a.nav-link.active(href='/') Home
        li.nav-item
          a.nav-link(href='/aboutPage') About
        li.nav-item
          a.nav-link(href='/chickRequest') Request Chicks
        li.nav-item
          a.nav-link(href='/contactPage') Contact
.container.py-5
  .row.justify-content-center
    .col-md-6
      .card.shadow.rounded-4
        .card-body
          h2.text-center.mb-4 Create Your Account
          form#farmerRegForm.farmerRegForm(action='/signup' method='post' onsubmit='return validateForm()')
            .mb-3
              label.form-label(for='farmerFName') Name
              input#farmerFName.form-control(type='text' name='farmerFName')
              .invalid-feedback Please enter your full name.
              #farmerFNameErr.showerr
            #ageField.mb-3(style='display: none;')
              label.form-label(for='farmerFAge') Age (20&ndash;30)
              input#farmerFAge.form-control(type='number' name='age' min='20' max='30')
              .invalid-feedback You must be between 20 and 30 years old.
              #farmerFAgeErr.showerr
            #genderField.mb-3(style='display: none;')
              label.form-label Gender`
              .form-check.form-check-inline
                input#male.form-check-input(type='radio' name='gender' value='male')
                label.form-label(for='male') Male
              .form-check.form-check-inline
                input#female.form-check-input(type='radio' name='gender' value='female')
                label.form-label(for='female') Female
              .invalid-feedback.d-block Please select your gender.
              #farmerFGenderErr.showerr
            #farmerFAddressField.mb-3(style='display: none;')
              label.form-label(for='farmerFAddress') Physical Address
              input#farmerFAddress.form-control(type='text' name='farmerFAddress')
              .invalid-feedback Please enter your physical address.
              #farmerFAddressErr.showerr
            .mb-3
              label.form-label(for='farmerFNumber') Phone Number
              input#farmerFNumber.form-control(type='tel' name='farmerFNumber')
              .invalid-feedback Please enter a valid contact number.
              #farmerFNumberErr.showerr
            .mb-3
              label.form-label(for='farmerFEmail') Email Address
              input#farmerFEmail.form-control(type='email' name='farmerFEmail')
              .invalid-feedback Please enter a valid email address.
              #farmerFEmailErr.showerr
            .mb-3
              label.form-label(for='userFRole') Role
              select#userFRole.form-select(name='userFRole')
                option(value='') Select role
                option(value='Farmer') Farmer
                option(value='SalesRep') Sales Rep
                option(value='BrooderManager') Brooder Manager
              #userFRoleErr.showerr
            #ninField.mb-3(style='display: none;')
              label.form-label(for='farmerFNIN') Farmer NIN Number
              input#farmerFNIN.form-control(type='text' name='farmerFNin')
              .invalid-feedback Please enter your NIN number.
              #farmerFNINErr.showerr
            #farmerTypeField.mb-3(style='display: none;')
              label.form-label(for='farmerFType') Farmer Type
              select#farmerFType.form-select(name='farmerFType')
                option(value='') Select farmer type
                option(value='Starter Farmer') Starter Farmer
                option(value='Returning Farmer') Returning Farmer
              .invalid-feedback Please select a farmer type.
              #farmerFTypeErr.showerr
            #recommenderNameField.mb-3(style='display: none;')
              label.form-label(for='farmerFRecommenderName') Recommender&apos;s Name
              input#farmerFRecommenderName.form-control(type='text' name='farmerFRecommenderName')
              .invalid-feedback Please enter recommender&apos;s name.
              #farmerFRecommenderNameErr.showerr
            #recommenderNinField.mb-3(style='display: none;')
              label.form-label(for='farmerFRecommenderNIN') Recommender&apos;s NIN Number
              input#farmerFRecommenderNIN.form-control(type='text' name='farmerFRecommenderNin')
              .invalid-feedback Please enter recommender&apos;s NIN.
              #farmerFRecommenderNINErr.showerr
            .mb-3
              label.form-label(for='farmerFPassword') Password
              input#farmerFPassword.form-control(type='password' name='farmerFPassword')
              .invalid-feedback Please enter a password.
              #farmerFPasswordErr.showerr
            .mb-3
              label.form-label(for='farmerFConfirmPassword') Confirm Password
              input#farmerFConfirmPassword.form-control(type='password' name='farmerFConfirmPassword')
              .invalid-feedback Passwords do not match.
              #farmerFConfirmPasswordErr.showerr
            .d-grid
              button.btn.btn-primary(type='submit')
                i.bi.bi-person-plus.me-2
                | Sign Up
          p.mt-3.text-center
            | Already have an account?
            a(href='/login') Login here
footer.whole-footer
  .container
    .row.text-center.text-md-start
      .container.mb-3.text-center
        h3 Quick Links
      ul.container.list-unstyled.text-center
        li
          a.text-white.text-decoration-none(href='/') Home
        li
          a.text-white.text-decoration-none(href='/aboutPage') About
        li
          a.text-white.text-decoration-none(href='/chickRequest') Chicks
        li
          a.text-white.text-decoration-none(href='/login') Login
        li
          a.text-white.text-decoration-none(href='/farmerReg') Register
    .container.mb-3.text-center
      h5 Join Us
    .d-flex.justify-content-center
      a.text-white(href='#')
        i.bi.bi-linkedin.fs-4
    hr.border-light
    p.text-center.mb-0 &copy; 2025 Young4Chicks. All rights reserved.
