head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Feeds Request-Form
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css' rel='stylesheet' integrity='sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr' crossorigin='anonymous')
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css')
  link(rel='stylesheet' href='/css/forms.css')

nav.navbar.navbar-expand-lg.navbar-dark.sticky-top
  .container
    a.navbar-brand.fw-bold(href='#') Young4ChickS
    button.navbar-toggler(type='button' data-bs-toggle='collapse' data-bs-target='#navbarNavDropdown')
      span.navbar-toggler-icon
    #navbarNavDropdown.collapse.navbar-collapse
      ul.navbar-nav.me-auto.mb-2.mb-lg-0
        li.nav-item
          a.nav-link.active(href='/') Home
        li.nav-item
          a.nav-link(href='/aboutPage') About Us
        li.nav-item
          a.nav-link(href='/chickRequest') Chicks
        li.nav-item
          a.nav-link(href='/contactPage') Contact
        li.nav-item
          a.nav-link(href='/login') Login

.form-container
  .card
    h2.form-title Feeds Request Form
    form#chickFeedsForm(action='/feedsRequest' method='post' )
      .mb-3
        label.form-label(for='farmerName') Farmer Name
        input#farmerFName.form-control(type='text' name='farmerName')
        #farmerFNameErr.showerr
      .mb-3
        label.form-label(for='farmerNIN') Farmer NIN Number
        input#farmerFNIN.form-control(type='text' name='farmerNIN')
        #farmerFNINErr.showerr
      .mb-3
        label.form-label(for='feedsFQuantity') Quantity
        input#feedsFQuantity.form-control(type='number' name='quantityFeeds')
        #feedsFQuantityErr.showerr
      .mb-3
        label.form-label(for='typeFeeds') Type of Feeds
        select#typeFChicks.form-select(name='typeFeeds')
          option(value='') Select feed type
          option(value='Starter Feeds') Starter Feeds
          option(value='Grower Feeds') Grower Feeds
          option(value='Finisher Feeds') Finisher Feeds
          option(value='Layer Feeds') Layer Feeds
          option(value='Medicated Feeds') Medicated Feeds
          option(value='Organic Feeds') Organic Feeds
          option(value='Supplementary Feeds') Supplementary Feeds
        #typeFChicksErr.showerr
      .mb-3
        label.form-label(for='farmerType') Type of Farmer
        select#farmerFType.form-select(name='farmerType')
          option(value='') Select farmer type
          option(value='Starter') Starter
          option(value='Returning') Returning
        #farmerFTypeErr.showerr
      button.btn.btn-submit.w-100(type='submit') Submit Request

footer.whole-footer
  .container
    .row.text-center.text-md-start
      .container.mb-3.text-center
        h3 Quick Links
      ul.container.list-unstyled.text-center
        li
          a.text-white(href='/') Home
        li
          a.text-white(href='/aboutPage') About
        li
          a.text-white(href='/chickRequest') Chicks
        li
          a.text-white(href='/login') Login
    .container.mb-3.text-center
      h5 Join Us
    .d-flex.justify-content-center.justify-content-md-center
      a(href='#')
        img(src='data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAAm0lEQVR4AWP4//8/RRhMyLfs3sNQvOk/KRikB24ATNB2yhEQJtoQuAEwzVAAYtPVAMJe4Cjf8l+0bsd/RkIGQAGc/ej9t/+TDt/7/+vPXzD/6Yfv/+2nHSXWAAT49P33/z9//4HZl569JM2Aqm3XwXyXGcfA/H///pFmgFj9DjCfp3IrTIgkA5ADbbAbQA6mKDPp9x7YBTOAIgwAVba5DGceMlQAAAAASUVORK5CYII=' alt='LinkedIn')
  hr.border-light
