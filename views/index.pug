section#pricing.bg-light.mt-5
  .container-lg
    .text-center
      h2 Young4Chicks Packages
      p.lead.text-muted Select a plan that fits your farming goals.
    .row.my-5.align-items-center.justify-content-center.g-5
      .col-8.col-lg-4.col-xl-3
        .card.border-0
          .card-body.text-center.py-4
            h4.card-title Beginner Farmer
            p.lead.card-subtitle Access to basic listings only
            p.display-5(text-id='pricing') $129
            p.card.text.mx-5.text-muted.d-none.d-lg-block
              | Perfect for new farmers starting out. List up to 3 poultry products and get limited visibility.
            a.btn.btn-lg.mt-3(href='#') Upgrade Now
      #bigcard.col-9.col-lg-4
