section#contact.py-5
  .container-lg
    .text-center.mb-5
      h2 Get In Touch
      p.lead Questions to ask? Fill out the form to contact e directly...
    .row.justify-content-center.my-5
      .col-lg-6
        form
          label.form-label(for='name') Name:
          .input-group.mb-4
            span.input-group-text
              i.bi.bi-person-fill
            input#name.form-control(type='name' placeholder='e.g. Kirabo Ketra')
            span.input-group-text
              span.tt(data-bs-placement='bottom' title='Pretty self explanatory really...')
                i.bi.bi-question-circle.text-muted
          label.form-label(for='email') Email address:
          .mb-4.input-group
            span.input-group-text
              i.bi.bi-envelope-fill
            input#email.form-control(type='email' placeholder='e.g. ketra014@gmail.com')
            span.input-group-text
              span.tt(data-bs-placement='bottom' title='Enter an email address we can reply to')
                i.bi.bi-question-circle.text-muted
          label.form-label(for='subject')
            | What is your question about? 
            span.required *
          .input-group.mb-4
            span.input-group-text
              i.bi.bi-chat-right-dots-fill
            select#subject.form-select
              option(value='pricing' selected='') Pricing query
              option(value='content') Content query
              option(value='other') Other query
          .form-floating.mb-4
            textarea#query.form-control(name='message' style='height: 140px;' placeholder='Your query...' required='')
            label(for='query')
              | Your query... 
              span.required *
          .form-check.mb-4
            input#newsletter.form-check-input(type='checkbox' name='newsletter')
            label.form-check-label(for='newsletter')
              | Subscribe to our newsletter for updates
          .mb-4.text-center
            button.btn.btn-secondary(type='submit') Submit Message
