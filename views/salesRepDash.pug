head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Sales Representative Dashboard - Young For Chicks
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css' rel='stylesheet')
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css')
  link(rel='stylesheet' href='/css/sales.css')
nav.navbar.navbar-expand-lg.navbar-dark.sticky-top
  .container
    a.navbar-brand.fw-bold(href='/') Young4ChickS
    button.navbar-toggler(type='button' data-bs-toggle='collapse' data-bs-target='#navbarNavDropdown')
      span.navbar-toggler-icon
    #navbarNavDropdown.collapse.navbar-collapse
      ul.navbar-nav.me-auto.mb-2.mb-lg-0
        li.nav-item
          a.nav-link(href='/') Home
        li.nav-item
          a.nav-link(href='/aboutPage') About
      a#logoutBtn.btn.btn-outline-light(type='button' title='Logout' href='/')
        i.bi.bi-box-arrow-right
        |  Logout
.dashboard-container
  aside.sidebar
    h4
      i.bi.bi-briefcase
      |  Sales Panel
    ul
      li
        a.sidebar-link.active(href='#' data-section='overview')
          i.bi.bi-graph-up
          |  Sales Overview
      li
        a.sidebar-link(href='#' data-section='clients')
          i.bi.bi-people
          |  My Clients
      li
        a.sidebar-link(href='#' data-section='orders')
          i.bi.bi-cart-check
          |  Orders
      li
        a.sidebar-link(href='#' data-section='newlead')
          i.bi.bi-person-plus
          |  New Lead
      li
        a.sidebar-link(href='#' data-section='myleads')
          i.bi.bi-list-check
          |  My Leads
  main.main-content
    section#overview.dashboard-section.active
      h2.mb-4 Welcome, Sales Representative!
      .stats-cards
        .stat-card.red
          h3 Total Sales
          .number #{totalSales} shs
        .stat-card.orange
          h3 Monthly Goal
          .number 1,525,000shs
        .stat-card.green
          h3 My Clients
          .number #{totalClients}
        .stat-card.blue
          h3 New Leads
          .number #{newLeadsCount}
    section#clients.dashboard-section
      h3.mb-3 My Clients
      
      // Search and Filter Section - Easy to understand!
      .row.mb-4
        .col-md-6
          .input-group
            input#clientSearch.form-control(type='text' placeholder='Search clients by name, email, or phone...')
            button.btn.btn-primary(type='button', style="padding-bottom: 10px")
              i.bi.bi-search
        .col-md-6
          select#statusFilter.form-select
            option(value='') All Status
            option(value='Active') Active Clients
            option(value='To Be Followed-up') Follow-up Needed
            option(value='New Client') New Clients
      
      // Add New Client Button - Simple and clear!
      .row.mb-3
        .col-12

          button#addClientBtn.btn.btn-success(type='button', style='padding-top: 2px; padding-bottom: 10px; padding-left: 20px; padding-right: 20px; font-size: 12px; size: 10px;' )
            i.bi.bi-person-plus.me-2
            | Add New Client


      
      .row
        if clients && clients.length > 0
          each client in clients
            .col-md-4.mb-3
              .client-card
                h5.mb-2= client.farmerFAddress || client.farmerFName
                p.text-muted.mb-1= client.farmerFEmail
                p.text-muted.mb-2= client.farmerFNumber
                .d-flex.justify-content-between.align-items-center
                  span.badge.bg-success= client.status || 'Active'
                .mt-3
                  button.btn.btn-sm.btn-primary.me-2 Contact
                  button.btn.btn-sm.btn-outline-info History
        else
          .col-12
            p No clients found.
    section#orders.dashboard-section
      h3.mb-3 Orders
      .card.mb-4
        .card-header
          h5 Farmer Requests
        .card-body
          .table-responsive
            table.table.table-striped
              thead
                tr
                  th Request ID
                  th Farm Name
                  th Chick Type
                  th Quantity
                  th Status
                  th Actions
              tbody
              tbody
                if orders && orders.length > 0
                  each order in orders
                    tr
                      td= order._id.toString().slice(-6)
                      td= order.farmerName
                      td= order.typeChicks
                      td= order.numChicks
                      td
                        span.badge(class=order.status === 'Pending' ? 'bg-warning' : (order.status === 'Approved' ? 'bg-success' : 'bg-danger'))= order.status
                      td
                        button.btn.btn-sm.btn-info View
                else
                  tr
                    td(colspan="6") No orders found
      .card
        .card-header
          h5 Recent Orders
        .card-body
          .table-responsive
            table.table.table-striped
              thead
                tr
                  th Order Number
                  th Client
                  th Product
                  th Quantity
                  th Total Amount
                  th Status
              tbody
                tr
                  td ORD.01
                  td John&apos;s Farm
                  td Broiler Chicks
                  td 400 chicks
                  td 102,500
                  td
                    span.badge.bg-success Delivered
                tr
                  td ORD.02
                  td Mary&apos;s Poultry
                  td Layer Chicks
                  td 200 chicks
                  td 201,350
                  td
                    span.badge.bg-warning Processing
                tr
                  td ORD.03
                  td Green Valley Farm
                  td Mixed Chicks
                  td 100 chicks
                  td 301,200
                  td
                    span.badge.bg-info Confirmed
    section#newlead.dashboard-section
      h3.mb-3 Add New Lead
      .card
        .card-body
          form#leadForm(action='/salesDash/add-lead' method='POST')
            .row
              .col-md-6.mb-3
                label.form-label Farm/Business Name
                input#farmName.form-control(type='text' name="farmName" placeholder='Enter farm name')
                #farmNameErr.showerr
              .col-md-6.mb-3
                label.form-label Owner&apos;s Name
                input#ownerName.form-control(type='text' name="ownerName" placeholder="Enter owner's name")
                #ownerNameErr.showerr
            .row
              .col-md-6.mb-3
                label.form-label Phone Number
                input#phoneNumber.form-control(type='text' name="phoneNumber" placeholder='+256 7XX XXX XXX')
                #phoneNumberErr.showerr
              .col-md-6.mb-3
                label.form-label How did you find this lead?
                select#leadSource.form-control(name="leadSource")
                  option(value='') Select source
                  option(value='Referral') Referral
                  option(value='Website') Website
                  option(value='Social Media') Social Media
                  option(value='Cold Call') Cold Call
                  option(value='Event') Event/Fair
                #leadSourceErr.showerr
            .mb-3
              label.form-label Notes (Optional)
              textarea#leadNotes.form-control(name="notes" rows='3' placeholder='Any additional information about the lead')
            button.btn.btn-primary(type='submit')
              i.bi.bi-plus-circle.me-2
              | Add Lead
    section#myleads.dashboard-section
      h3.mb-3 My Leads
      .card
        .card-body
          .table-responsive
            table.table.table-striped
              thead
                tr
                  th Farm Name
                  th Owner Name
                  th Phone
                  th Source
                  th Status
                  th Actions
              tbody#leadsTable
                if leads && leads.length > 0
                  each lead in leads
                    tr
                      td= lead.farmName
                      td= lead.ownerName
                      td= lead.phoneNumber
                      td= lead.leadSource
                      td
                        span.badge.bg-primary= lead.status
                      td
                        form(action=`/salesDash/convert-lead/${lead._id}` method="POST" style="display:inline")
                          button.btn.btn-sm.btn-success.me-1(type="button")
                            i.bi.bi-telephone
                            |  Call
                          button.btn.btn-sm.btn-primary(type="submit")
                            i.bi.bi-arrow-up-circle
                            |  Convert
                else
                  tr
                    td(colspan="6") No leads found
footer.whole-footer
  .container.text-center
    h5.mb-3 Young4ChickS
    p Your trusted partner for quality chicks
    hr.border-light
    p.mb-0 &copy; 2025 Young4Chicks. All rights reserved.

// Simple Modal for Adding New Client - Easy to understand!
#addClientModal.modal.fade(tabindex='-1')
  .modal-dialog
    .modal-content
      .modal-header
        h5.modal-title Add New Client
        button.btn-close(type='button' data-bs-dismiss='modal')
      .modal-body
        form#addClientForm(action="/salesDash/add-client" method="POST")
          .mb-3
            label.form-label(for='clientFarmName') Farm Name
            input#clientFarmName.form-control(type='text' name="clientFarmName" required)
          .mb-3
            label.form-label(for='clientOwnerName') Owner Name
            input#clientOwnerName.form-control(type='text' name="clientOwnerName" required)
          .mb-3
            label.form-label(for='clientEmail') Email
            input#clientEmail.form-control(type='email' name="clientEmail" required)
          .mb-3
            label.form-label(for='clientPhone') Phone Number
            input#clientPhone.form-control(type='tel' name="clientPhone" required)
      .modal-footer
        button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cancel
        button#saveClientBtn.btn.btn-primary(type='submit' form="addClientForm") Save Client

script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js')
script.
  document.addEventListener('DOMContentLoaded', function () {
  const sidebarLinks = document.querySelectorAll('.sidebar-link');
  const sections = document.querySelectorAll('.dashboard-section');
  sidebarLinks.forEach(link => {
  link.addEventListener('click', function (e) {
  e.preventDefault();
  sidebarLinks.forEach(l => l.classList.remove('active'));
  sections.forEach(section => section.classList.remove('active'));
  this.classList.add('active');
  const targetSection = this.getAttribute('data-section');
  document.getElementById(targetSection).classList.add('active');
  });
  });

  // NEW: Add Client Modal Functionality - Easy to understand!
  const addClientBtn = document.getElementById('addClientBtn');
  const addClientModal = new bootstrap.Modal(document.getElementById('addClientModal'));
  const saveClientBtn = document.getElementById('saveClientBtn');
  const addClientForm = document.getElementById('addClientForm');

  // Open modal when "Add New Client" button is clicked
  addClientBtn.addEventListener('click', function() {
    addClientModal.show();
  });

  // Save new client when form is submitted
  saveClientBtn.addEventListener('click', function() {
    // Get form values
    const farmName = document.getElementById('clientFarmName').value.trim();
    const ownerName = document.getElementById('clientOwnerName').value.trim();
    const email = document.getElementById('clientEmail').value.trim();
    const phone = document.getElementById('clientPhone').value.trim();
    const status = document.getElementById('clientStatus').value;

    // Simple validation - Easy to understand!
    if (!farmName || !ownerName || !email || !phone || !status) {
      alert('Please fill in all fields!');
      return;
    }

    // Add new client to the page (in real app, this would save to database)
    addNewClientToPage(farmName, ownerName, email, phone, status);
    
    // Close modal and reset form
    addClientModal.hide();
    addClientForm.reset();
    
    alert('Client added successfully!');
  });

  // Function to add new client to the page - Simple and clear!
  function addNewClientToPage(farmName, ownerName, email, phone, status) {
    const clientsRow = document.querySelector('#clients .row:last-child');
    
    // Create new client card
    const newClientCard = document.createElement('div');
    newClientCard.className = 'col-md-4 mb-3';
    newClientCard.innerHTML = `
      <div class="client-card">
        <h5 class="mb-2">${farmName}</h5>
        <p class="text-muted mb-1">${email}</p>
        <p class="text-muted mb-2">${phone}</p>
        <div class="d-flex justify-content-between align-items-center">
          <span class="badge bg-${getStatusColor(status)}">${status}</span>
          <strong class="text-${getStatusColor(status)}">New Client</strong>
        </div>
        <div class="mt-3">
          <button class="btn btn-sm btn-primary me-2">Contact</button>
          <button class="btn btn-sm btn-outline-info">History</button>
        </div>
      </div>
    `;
    
    // Add to page
    clientsRow.appendChild(newClientCard);
  }

  // Helper function to get status color - Makes the code cleaner!
  function getStatusColor(status) {
    switch(status) {
      case 'Active': return 'success';
      case 'To Be Followed-up': return 'warning';
      case 'New Client': return 'info';
      default: return 'primary';
    }
  }

  // NEW: Search and Filter Functionality - Easy to understand!
  const clientSearch = document.getElementById('clientSearch');
  const statusFilter = document.getElementById('statusFilter');
  const clientCards = document.querySelectorAll('#clients .client-card');

  // Search functionality
  clientSearch.addEventListener('input', function() {
    const searchTerm = this.value.toLowerCase();
    filterClients(searchTerm, statusFilter.value);
  });

  // Filter functionality
  statusFilter.addEventListener('change', function() {
    const searchTerm = clientSearch.value.toLowerCase();
    filterClients(searchTerm, this.value);
  });

  // Function to filter clients - Simple and clear!
  function filterClients(searchTerm, statusFilter) {
    clientCards.forEach(card => {
      const farmName = card.querySelector('h5').textContent.toLowerCase();
      const email = card.querySelector('p').textContent.toLowerCase();
      const phone = card.querySelectorAll('p')[1].textContent.toLowerCase();
      const status = card.querySelector('.badge').textContent;
      
      const matchesSearch = farmName.includes(searchTerm) || 
                           email.includes(searchTerm) || 
                           phone.includes(searchTerm);
      
      const matchesStatus = !statusFilter || status === statusFilter;
      
      // Show/hide card based on filters
      if (matchesSearch && matchesStatus) {
        card.closest('.col-md-4').style.display = 'block';
      } else {
        card.closest('.col-md-4').style.display = 'none';
      }
    });
  }
  });
  const leadForm = document.getElementById('leadForm');
  function validateForm() {
  let farmName = document.getElementById('farmName').value.trim();
  let ownerName = document.getElementById('ownerName').value.trim();
  let phoneNumber = document.getElementById('phoneNumber').value.trim();
  let leadSource = document.getElementById('leadSource').value.trim();
  let farmNameErr = document.getElementById('farmNameErr');
  let ownerNameErr = document.getElementById('ownerNameErr');
  let phoneNumberErr = document.getElementById('phoneNumberErr');
  let leadSourceErr = document.getElementById('leadSourceErr');
  let errFlag = false;
  if (farmName === '') {
  farmNameErr.innerHTML = 'Farm name is required!';
  errFlag = true;
  } else {
  farmNameErr.innerHTML = '';
  }
  if (ownerName === '') {
  ownerNameErr.innerHTML = 'Owner name is required!';
  errFlag = true;
  } else {
  ownerNameErr.innerHTML = '';
  }
  if (phoneNumber === '') {
  phoneNumberErr.innerHTML = 'Phone number is required!';
  errFlag = true;
  } else {
  phoneNumberErr.innerHTML = '';
  }
  if (leadSource === '') {
  leadSourceErr.innerHTML = 'Please select lead source!';
  errFlag = true;
  } else {
  leadSourceErr.innerHTML = '';
  }
  if (!errFlag) {
  alert('New lead added successfully!');
  leadForm.reset();
  }
  return false;
  }
